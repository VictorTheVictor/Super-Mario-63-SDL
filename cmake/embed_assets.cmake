# Writes OUT: a C++ file with the assets compiled into the executable when present at build
# time. They belong to their makers and are not in the repository: put your own copies in
# place.
# - registerEmbeddedFonts() hands the TrueType fonts found in FONT_DIR to text layout as
#   fallbacks for the SWF's incomplete embedded fonts. Recognized (any letter case):
#   arial.ttf, arialbd.ttf, ariali.ttf, comic.ttf, comicbd.ttf (Microsoft's).
# - embeddedPauseSound() is the MP3 PAUSE_SOUND (played when the pause menu opens and
#   closes), or empty.
#
# usage: cmake -DFONT_DIR=dir -DPAUSE_SOUND=file -DOUT=file.cpp -P embed_assets.cmake

# A C array of a file's bytes.
function(byte_array path var out)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){16})" "\\1\n" bytes "${bytes}")
    set(${out} "static const unsigned char ${var}[] = {\n${bytes}};\n\n" PARENT_SCOPE)
endfunction()

set(known
    "arial.ttf|Arial|false|false"
    "arialbd.ttf|Arial|true|false"
    "ariali.ttf|Arial|false|true"
    "comic.ttf|Comic Sans MS|false|false"
    "comicbd.ttf|Comic Sans MS|true|false")
file(GLOB files "${FONT_DIR}/*")
set(arrays "")
set(calls "")
set(n 0)
foreach(path IN LISTS files)
    get_filename_component(file "${path}" NAME)
    string(TOLOWER "${file}" lower)
    foreach(entry IN LISTS known)
        string(REPLACE "|" ";" fields "${entry}")
        list(GET fields 0 name)
        if(NOT lower STREQUAL name)
            continue()
        endif()
        list(GET fields 1 family)
        list(GET fields 2 bold)
        list(GET fields 3 italic)
        byte_array("${path}" "kFont${n}" array)
        string(APPEND arrays "// ${file}\n${array}")
        string(APPEND calls "    flash::addFallbackFont(flash::loadTrueType(kFont${n}, sizeof kFont${n}, \"${family}\", ${bold}, ${italic}));\n")
        math(EXPR n "${n} + 1")
    endforeach()
endforeach()

set(sound "std::pair<const unsigned char*, size_t> embeddedPauseSound() { return {nullptr, 0}; }\n")
if(EXISTS "${PAUSE_SOUND}")
    byte_array("${PAUSE_SOUND}" "kPauseSound" array)
    get_filename_component(file "${PAUSE_SOUND}" NAME)
    string(APPEND arrays "// ${file}\n${array}")
    set(sound "std::pair<const unsigned char*, size_t> embeddedPauseSound() { return {kPauseSound, sizeof kPauseSound}; }\n")
endif()

file(WRITE "${OUT}.tmp" "// Generated by cmake/embed_assets.cmake.\n#include \"EmbeddedAssets.h\"\n#include \"flash/TrueType.h\"\n\n"
                        "${arrays}void registerEmbeddedFonts() {\n${calls}}\n\n${sound}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
