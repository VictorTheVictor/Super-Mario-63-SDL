# Writes OUT: a C++ file defining registerEmbeddedFonts(), which hands the TrueType fonts
# found in FONT_DIR to text layout as fallbacks for the SWF's incomplete embedded fonts.
# They are Microsoft's fonts and not in the repository: put your own copies in fonts/.
# Recognized (any letter case): arial.ttf, arialbd.ttf, ariali.ttf, comic.ttf, comicbd.ttf.
#
# usage: cmake -DFONT_DIR=dir -DOUT=file.cpp -P embed_fonts.cmake
set(known
    "arial.ttf|Arial|false|false"
    "arialbd.ttf|Arial|true|false"
    "ariali.ttf|Arial|false|true"
    "comic.ttf|Comic Sans MS|false|false"
    "comicbd.ttf|Comic Sans MS|true|false")
file(GLOB files "${FONT_DIR}/*")
set(arrays "")
set(calls "")
set(n 0)
foreach(path IN LISTS files)
    get_filename_component(file "${path}" NAME)
    string(TOLOWER "${file}" lower)
    foreach(entry IN LISTS known)
        string(REPLACE "|" ";" fields "${entry}")
        list(GET fields 0 name)
        if(NOT lower STREQUAL name)
            continue()
        endif()
        list(GET fields 1 family)
        list(GET fields 2 bold)
        list(GET fields 3 italic)
        file(READ "${path}" hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "((0x..,){16})" "\\1\n" bytes "${bytes}")
        string(APPEND arrays "// ${file}\nstatic const unsigned char kFont${n}[] = {\n${bytes}};\n\n")
        string(APPEND calls "    flash::addFallbackFont(flash::loadTrueType(kFont${n}, sizeof kFont${n}, \"${family}\", ${bold}, ${italic}));\n")
        math(EXPR n "${n} + 1")
    endforeach()
endforeach()
file(WRITE "${OUT}.tmp" "// Generated by cmake/embed_fonts.cmake.\n#include \"EmbeddedFonts.h\"\n#include \"flash/TrueType.h\"\n\n"
                        "${arrays}void registerEmbeddedFonts() {\n${calls}}\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
