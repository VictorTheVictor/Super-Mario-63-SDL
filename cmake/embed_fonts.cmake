# Writes OUT: a C++ file defining registerEmbeddedFonts(), which hands Comic Sans MS
# (from COMIC_TTF, when that file exists) to text layout as a fallback font. The font is
# Microsoft's and is not in the repository: put your own COMIC.TTF in fonts/ to embed it.
#
# usage: cmake -DCOMIC_TTF=path -DOUT=file.cpp -P embed_fonts.cmake
set(body "void registerEmbeddedFonts() {}\n")
if(EXISTS "${COMIC_TTF}")
    file(READ "${COMIC_TTF}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
    set(body "static const unsigned char kComicSans[] = {\n${bytes}};\n\n"
             "void registerEmbeddedFonts() {\n"
             "    flash::addFallbackFont(flash::loadTrueType(kComicSans, sizeof kComicSans, \"Comic Sans MS\", false, false));\n"
             "}\n")
endif()
file(WRITE "${OUT}.tmp" "// Generated by cmake/embed_fonts.cmake.\n#include \"EmbeddedFonts.h\"\n#include \"flash/TrueType.h\"\n\n${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
