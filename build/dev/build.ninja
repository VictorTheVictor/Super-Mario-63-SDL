#############################################
# Folder: /home/fujiwara/Projects/Super-Mario-63/build/dev

build all: phony libsm63_physics.a sm63 physics_tests course_object_tests sequence_tests sign_tests enemy_tests item_tests fludd_tests platform_tests area_tests audio_tests

