build /home/fujiwara/Projects/Super-Mario-63/build/dev/CMakeFiles/cmake.verify_globs: VERIFY_GLOBS | /home/fujiwara/Projects/Super-Mario-63/build/dev/CMakeFiles/VerifyGlobs.cmake_force
  pool = console
  restat = 1


