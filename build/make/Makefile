# Build rule for target.
course_object_tests: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 course_object_tests
.PHONY : course_object_tests

# fast build rule for target.
course_object_tests/fast:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/course_object_tests.dir/build.make CMakeFiles/course_object_tests.dir/build
.PHONY : course_object_tests/fast

